{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "builtbyclerise",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-20",
  // The prerendered site. Cloudflare serves these files directly (with _headers and _redirects);
  // the Worker only runs for /api/*.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"],
  },
  // Cloudflare Email Service. The recipient comes from the CONTACT_TO secret.
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "CONTACT_FROM": "hello@builtbyclerise.co.za",
  },
  // Secrets (set in the dashboard or with `wrangler secret put`): CONTACT_TO, TURNSTILE_SECRET_KEY
  "observability": { "enabled": true },
}
