# Normalise everything to LF in the repo and on checkout (containers choke on CRLF).
* text=auto eol=lf

# Explicit LF for anything that runs or is parsed inside containers.
*.sh        text eol=lf
Dockerfile  text eol=lf
*.Dockerfile text eol=lf
*.php       text eol=lf
*.blade.php text eol=lf
*.vue       text eol=lf
*.ts        text eol=lf
*.mts       text eol=lf
*.js        text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.sql       text eol=lf
*.conf      text eol=lf
*.ini       text eol=lf
*.md        text eol=lf
*.env       text eol=lf
.env.example text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.xml       text eol=lf

# Windows-native scripts keep CRLF.
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binaries.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.sqlite binary
